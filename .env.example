# Copy to .env and fill in. Leave everything empty to use the deterministic planner.

# Option A: Qwen locally with Ollama (free, no key): `ollama pull qwen3`, nothing else needed.
# Option B: Qwen in the cloud via any OpenAI-compatible API, e.g. OpenRouter (free key):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<a Qwen model id, e.g. one ending in :free>

# Option C: Claude
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic   # use Claude even if a local model is running

# PORT=4000
